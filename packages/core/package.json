{
  "name": "@speajus/rlsify-core",
  "version": "0.1.0",
  "description": "Core library for generating PostgreSQL Row-Level Security policies",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "clean": "rm -rf dist *.tsbuildinfo",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src"
  },
  "keywords": [
    "postgresql",
    "rls",
    "row-level-security",
    "security",
    "database",
    "sql"
  ],
  "author": "Justin Spears <speajus@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "@speajus/diblob": "^1.0.2",
    "@speajus/rlsify-types": "workspace:*"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^11.10.0",
    "@types/node": "^20.11.0",
    "@types/pg": "^8.11.10",
    "pg": "^8.13.0",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0"
  }
}
