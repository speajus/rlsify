{
  "name": "@speajus/rlsify-service",
  "version": "0.1.0",
  "description": "Backend service for RLSify UI - gRPC/Connect API for schema introspection and policy management",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
		"test:integration": "RUN_AUGGIE_INTEGRATION_TESTS=true vitest run src/services/auggie-service.integration.test.ts"
  },
  "dependencies": {
    "@augmentcode/auggie-sdk": "^0.1.11",
    "@connectrpc/connect": "^2.1.0",
    "@connectrpc/connect-node": "^2.1.0",
    "@speajus/diblob": "^1.0.2",
    "@speajus/diblob-config": "^1.0.2",
    "@speajus/diblob-connect": "^1.0.2",
    "@speajus/diblob-logger": "^1.0.2",
    "@speajus/rlsify-core": "workspace:*",
    "@speajus/rlsify-types": "workspace:*",
    "ai": "^5.0.116",
    "pg": "^8.13.0",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@bufbuild/protobuf": "^2.10.0",
     "@swc/core": "^1.15.7",
     "@types/node": "^20.0.0",
    "@types/pg": "^8.11.10",
    "dotenv": "^16.4.5",
    "tsup": "^8.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^1.2.0"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./services": {
      "import": "./dist/services/index.js",
      "types": "./dist/services/index.d.ts"
    }
  },
  "files": [
    "dist"
  ]
}
