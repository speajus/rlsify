{
  "name": "@speajus/rlsify-desktop",
  "version": "0.1.0",
  "description": "RLSify Desktop Application - Electron-based PostgreSQL RLS policy editor",
  "main": ".vite/build/main.js",
  "private": true,
  "scripts": {
		"predev": "pnpm -w --filter @speajus/rlsify-types build && pnpm -w --filter @speajus/rlsify-core build && pnpm -w --filter @speajus/rlsify-service build",
    "dev": "electron-forge start",
    "build": "electron-forge make",
    "package": "electron-forge package",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.0.0",
    "@connectrpc/connect": "^2.0.0",
    "@connectrpc/connect-web": "^2.1.0",
    "@internationalized/date": "^3.6.0",
    "@speajus/diblob": "^1.0.2",
    "@speajus/diblob-config": "^1.0.2",
    "@speajus/diblob-connect": "^1.0.2",
    "@speajus/diblob-logger": "^1.0.2",
    "@speajus/rlsify-core": "workspace:*",
    "@speajus/rlsify-service": "workspace:*",
    "@speajus/rlsify-types": "workspace:*",
    "@speajus/rlsify-ui": "workspace:*",
    "bits-ui": "^2.14.4",
    "clsx": "^2.1.1",
    "electron-store": "^11.0.2",
    "esm-env": "^1.2.1",
    "lucide-svelte": "^0.460.0",
    "pg": "^8.15.0",
    "runed": "^0.15.0",
    "style-to-object": "^1.0.8",
    "svelte": "^5.46.0",
    "svelte-jsoneditor": "^3.11.0",
    "tabbable": "^6.2.0",
    "tailwind-merge": "^3.4.0",
    "tailwind-variants": "^3.2.2"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.0.0",
    "@electron-forge/maker-dmg": "^7.0.0",
    "@electron-forge/maker-squirrel": "^7.0.0",
    "@electron-forge/maker-zip": "^7.0.0",
    "@electron-forge/plugin-vite": "^7.0.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@tsconfig/svelte": "^5.0.6",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "autoprefixer": "^10.4.22",
    "electron": "^28.0.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.0.0",
    "vite": "^6.0.0"
  },
  "config": {
    "forge": "./forge.config.mts"
  }
}
