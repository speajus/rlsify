{
  "name": "@speajus/rlsify-ui",
  "version": "0.1.0",
  "description": "Svelte-based web UI for creating RLS policies",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --threshold warning",
    "clean": "rm -rf dist .svelte-kit"
  },
  "keywords": [
    "svelte",
    "rls",
    "postgresql",
    "ui"
  ],
  "author": "Justin Spears <speajus@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "@bufbuild/protobuf": "^2.10.0",
    "@connectrpc/connect": "^2.1.0",
    "@connectrpc/connect-web": "^2.1.0",
    "@speajus/rlsify-core": "workspace:*",
    "@speajus/rlsify-types": "workspace:*"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^3.0.1",
    "@tsconfig/svelte": "^5.0.2",
    "svelte": "^5.0.0",
    "svelte-check": "^3.6.2",
    "tslib": "^2.6.2",
    "typescript": "^5.3.3",
    "vite": "^5.0.10"
  }
}

