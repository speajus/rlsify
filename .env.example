# PostgreSQL Configuration
POSTGRES_DB=rlsify
POSTGRES_USER=rlsify
POSTGRES_PASSWORD=rlsify_dev_password
POSTGRES_PORT=5432
POSTGRES_HOST_AUTH_METHOD=scram-sha-256

# UI Configuration
UI_PORT=5174
VITE_PORT=5174
NODE_VERSION=20

# pgAdmin Configuration (optional - use with --profile tools)
PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@rlsify.local
PGADMIN_PASSWORD=admin

# Database Connection String (for reference)
DATABASE_URL=postgresql://rlsify:rlsify_dev_password@localhost:5432/rlsify

